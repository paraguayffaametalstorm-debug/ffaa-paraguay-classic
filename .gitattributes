# .gitattributes — PARAGUAY-FFAA | METALSTORM
# Normaliza line endings en el repositorio.
# Causa raíz de HALL-068.

# Por defecto, normalizar a LF en el repo
* text=auto eol=lf

# Archivos binarios explícitos (no tocar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary

# Scripts de Windows (mantener CRLF si algún día se agregan)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentación: permitir LF estricto
*.md text eol=lf

# SQL: LF estricto
*.sql text eol=lf

# JS/JSON/CSS/HTML: LF estricto
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf