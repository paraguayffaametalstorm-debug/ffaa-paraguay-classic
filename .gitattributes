# Normalizar line endings a LF en todo el repo
# Ref: BL-023 · HALL-068
* text=auto eol=lf

# Forzar LF en archivos específicos
*.js   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Binarios (sin tocar)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
*.zip  binary
