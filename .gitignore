# ============================================================
# PARAGUAY-FFAA | METALSTORM — .gitignore
# ============================================================

# ---------- Entorno y credenciales ----------
.env
.env.local
.env.*.local

# ---------- Dependencias ----------
node_modules/
package-lock.json

# ---------- Cloudinary ----------
cloudinary-abilities-urls.json

# ---------- Backups generados por scripts ----------
*.bak-*
*.bak

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Sistema operativo ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Editores ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Temporales ----------
*.tmp
*.temp

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/

# ---------- Node/Python misceláneos ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/